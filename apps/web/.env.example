# Dummy local values only — never put real credentials here.
NEXT_PUBLIC_APP_NAME="Kisan4U Storefront"

# Seller registration happens here in the storefront app, but seller
# login/panel lives in apps/dashboard — used only for a post-registration
# link, not for anything auth-related.
NEXT_PUBLIC_DASHBOARD_URL="http://localhost:3001"

# Auth.js session-signing secret. This dummy value is fine for local dev
# only — generate a real random secret before ever deploying anywhere.
# IMPORTANT: this MUST be a different value from apps/dashboard's
# AUTH_SECRET. Both apps run on `localhost` and browsers don't scope
# cookies by port, so if both apps use the same secret AND the same
# cookie names, a session cookie from one app can decrypt cleanly on the
# other. Cookie names are already kept app-specific (see
# packages/auth/src/cookies.ts) — keep the secrets distinct too, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="dev-only-insecure-secret-change-me-web"

# Shared internal secret so apps/dashboard's admin Server Actions can call
# this app's /api/revalidate-homepage after a homepage-CMS/site-settings
# mutation (apps/web and apps/dashboard are separate Next.js processes —
# revalidateTag() in one has no effect on the other's cache). MUST match
# apps/dashboard's REVALIDATE_SECRET exactly. Not a session/auth secret —
# safe to rotate independently of AUTH_SECRET.
REVALIDATE_SECRET="dev-only-insecure-revalidate-secret-change-me"

# Signs bearer JWTs for the Android/iOS mobile clients (apps/mobile) —
# see packages/auth/src/mobile-tokens.ts. Deliberately separate from
# AUTH_SECRET (mobile uses bearer tokens, not the browser cookie session)
# and from apps/dashboard's own secrets. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MOBILE_AUTH_SECRET="dev-only-insecure-mobile-secret-change-me"

# Old app builds issued refresh tokens without a server-side session id.
# They may exchange one legacy refresh token before this ISO-8601 cutoff;
# after it, old-style access and refresh tokens are rejected.
MOBILE_LEGACY_TOKEN_CUTOFF="2026-12-31T23:59:59+05:30"

# APKs at or above this semantic version receive the non-enumerating OTP
# response. Missing/older version headers retain the compatibility payload
# until the Play minimum-version rollout is complete.
MOBILE_GENERIC_OTP_MIN_VERSION="3.1.0"

# OTP codes are stored only as HMAC digests. Use a dedicated random secret;
# changing it invalidates every code that is still waiting to be verified.
OTP_HMAC_SECRET="dev-only-insecure-otp-hmac-secret-change-me"

# All OTP controls are runtime-configurable (no rebuild required).
OTP_TTL_MINUTES=5
OTP_SEND_COOLDOWN_SECONDS=60
OTP_SEND_PHONE_HOURLY_LIMIT=5
OTP_SEND_PHONE_DAILY_LIMIT=10
OTP_SEND_IP_HOURLY_LIMIT=60
OTP_SEND_IP_WARNING_THRESHOLD=20
OTP_CODE_MAX_ATTEMPTS=5
OTP_VERIFY_FAILURE_HOURLY_LIMIT=10
OTP_VERIFY_LOCKOUT_MINUTES=30

# Protects POST /api/cron/security-cleanup. Call it with
# Authorization: Bearer <CRON_SECRET> (or x-cron-secret) at least daily.
CRON_SECRET="dev-only-insecure-cron-secret-change-me"

# Seller application upload guardrails (runtime-configurable).
SELLER_ONBOARDING_TTL_MINUTES=15
SELLER_ONBOARDING_MAX_UPLOADS=6
SELLER_UPLOAD_IP_HOURLY_LIMIT=60
SELLER_UPLOAD_IP_WARNING_THRESHOLD=20

# HMAC key for irreversible phone/email fingerprints retained after account deletion.
# Keep this independent from every auth/session secret.
ACCOUNT_DELETION_PEPPER="dev-only-insecure-account-deletion-pepper-change-me"

# --- SMS gateway (SMS Hub Solutions — net.smshubsolutions.com) ----------
# Real OTP / notification SMS. Leave these UNSET for local dev: the SMS
# provider then falls back to logging the message (and the OTP code) to
# the server console instead of sending anything. Set the three
# account-level keys to switch on real delivery
# (packages/providers/src/sms.ts):
#   SMSHUB_USER            account Profile ID / username
#   SMSHUB_AUTHKEY         API auth key
#   SMSHUB_SENDER          approved 6-char Sender ID / header
#   SMSHUB_ENTITY_ID       DLT Entity / PE ID (12-19 digits). OPTIONAL —
#                          SMS Hub has it on file against the account and
#                          templateid alone is normally enough; set it
#                          only if the gateway starts rejecting sends.
# Per DLT rules the sent text must exactly match a registered template.
# SMSHUB_OTP_TEMPLATE is that approved wording VERBATIM (case, spacing and
# punctuation must match the DLT registration exactly or the telco drops
# the SMS with error 1556). It may have more than one {#var#} slot — the
# last {#var#} (or an explicit {code}/{otp} marker) gets the 6-digit code,
# every other {#var#} gets SMSHUB_OTP_SALUTATION (default "Customer").
# Tagged with SMSHUB_OTP_TEMPLATE_ID; the template must be registered
# against the SMSHUB_SENDER header.
#   SMSHUB_OTP_TEMPLATE       "Dear {#var#}, Your verification OTP for Kisan4u is {#var#}. Thank You"
#   SMSHUB_OTP_TEMPLATE_ID    DLT template id for that OTP template
#   SMSHUB_OTP_SALUTATION     optional; fills the non-code {#var#} slot(s)
# Optional — the "dealer account approved" notification (best-effort; the
# approval never fails if the SMS does):
#   SMSHUB_DEALER_APPROVED_TEMPLATE      approved wording, no variables
#   SMSHUB_DEALER_APPROVED_TEMPLATE_ID   its DLT template id
# SMSHUB_USER=""
# SMSHUB_AUTHKEY=""
# SMSHUB_SENDER=""
# SMSHUB_ENTITY_ID=""
# SMSHUB_OTP_TEMPLATE=""
# SMSHUB_OTP_TEMPLATE_ID=""

# --- Meta Pixel + Conversions API (see apps/web/src/lib/meta/capi.ts) ---
# Pixel (dataset) id from Events Manager. Unset = no pixel and no cookie banner.
# NEXT_PUBLIC_ vars are baked in at build time: rebuild web after changing it.
# NEXT_PUBLIC_META_PIXEL_ID=""
# Conversions API access token (Events Manager -> pixel -> Settings). SECRET.
# META_CAPI_ACCESS_TOKEN=""
# Temporary, while checking events under Events Manager -> Test events. Remove after.
# META_TEST_EVENT_CODE=""
# Optional Graph API version override (default v22.0).
# META_GRAPH_API_VERSION=""
SITE_ORIGIN=https://katra4u.com
PRIVATE_LICENCE_UPLOAD_ROOT=/home/buru/kisan4u-nextjs/apps/dashboard/storage/private-licences
DOC_URL_SIGNING_SECRET=replace-with-a-long-random-secret
