# Copy this file to `.env.local` (already git-ignored — see .gitignore's
# `.env*.local` rule) and fill in your own values. Never commit your real
# IP as a plain `.env` — that file is NOT git-ignored by this template.

# Base URL of the Next.js API (apps/web) the mobile app talks to.
# Find your computer's LAN IP with `ipconfig` (look for IPv4 Address under
# your active Wi-Fi adapter) and start the backend with:
#   pnpm --filter web dev -- --hostname 0.0.0.0
# Then point this at that IP + the web app's port (3000 by default).
# Your phone and computer must be on the SAME Wi-Fi network.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
