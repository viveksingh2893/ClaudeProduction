# Dummy local values only — never put real credentials here.
NEXT_PUBLIC_APP_NAME="Kisan4U Dashboard"

# Auth.js session-signing secret. This dummy value is fine for local dev
# only — generate a real random secret before ever deploying anywhere.
# IMPORTANT: this MUST be a different value from apps/web's AUTH_SECRET
# — see the matching note in apps/web/.env.example for why.
AUTH_SECRET="dev-only-insecure-secret-change-me-dashboard"

# The storefront app's base URL and the shared secret used to ping its
# /api/revalidate-homepage endpoint after a homepage-CMS/site-settings
# admin mutation — see apps/web/src/app/api/revalidate-homepage/route.ts
# and src/lib/revalidate-storefront.ts. REVALIDATE_SECRET MUST match
# apps/web's exactly. If either is unset, admin edits still reach the
# storefront within the cache's own 60s TTL — this just makes it instant.
STOREFRONT_URL="http://localhost:3000"
REVALIDATE_SECRET="dev-only-insecure-revalidate-secret-change-me"

# POS dealer registration (apps/dashboard/src/app/admin/pos) uploads GST/
# license documents through @kisan4u/providers' localStorageProvider.
# Point this at apps/web's own storage/uploads directory (both apps must
# run on the same host/filesystem — see packages/providers/src/storage.ts)
# so the uploaded file lands somewhere apps/web's existing
# /api/uploads/[...path] route can actually serve it back out. Leave unset
# in a deployment where the two apps don't share a filesystem — dealer
# document upload from POS would need a real cross-app API call instead.
UPLOAD_STORAGE_ROOT="../web/storage/uploads"

# RapidShyp (delivery aggregator) — the one REAL third-party credential in
# this app; every other provider above stays a local mock. Generated in
# the RapidShyp portal under Settings > Configure API. Leave unset and
# "Send to RapidShyp"/"Refresh status" on the admin order detail page
# will fail with a clear error rather than silently no-op.
RAPIDSHYP_API_KEY=""
DELHIVERY_API_TOKEN=
DELHIVERY_TOKEN_MARKETING1=
DELHIVERY_TOKEN_500G=
DELHIVERY_TOKEN_1=
ACCOUNT_DELETION_PEPPER="dev-only-insecure-account-deletion-pepper-change-me"
PRIVATE_LICENCE_UPLOAD_ROOT=/home/buru/kisan4u-nextjs/apps/dashboard/storage/private-licences
