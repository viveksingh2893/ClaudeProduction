# Root/local-dev environment variables — DUMMY VALUES ONLY.
# Copy this file to `.env` (git-ignored) if you want docker-compose and
# root-level tooling to pick these up automatically.
#
# Never put real/production credentials in this repo. See
# EXISTING_SYSTEM_ANALYSIS.md §8 for a flagged example of what NOT to do.

# --- Local Postgres (docker-compose.yml) ---
POSTGRES_USER=kisan4u_dev
POSTGRES_PASSWORD=kisan4u_dev_password
POSTGRES_DB=kisan4u_dev
# Not 5432 (often taken by a native/system Postgres install) and not 5433
# (falls inside a Windows Hyper-V/WSL dynamic port-exclusion range on some
# machines, which silently blocks Docker from binding it). Change this if
# 6100 is unavailable on your machine too.
POSTGRES_PORT=6100

# --- Prisma (packages/db) ---
DATABASE_URL="postgresql://kisan4u_dev:kisan4u_dev_password@localhost:6100/kisan4u_dev?schema=public"
